{
  "name": "mailbeacon",
  "version": "0.3.0",
  "description": "Fake SMTP server that forwards incoming email to Gotify, ntfy, Pushover, Discord, Slack, Telegram, Apprise and webhooks",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.13.0",
    "nodemailer": "^10.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "mailparser": "^3.9.40",
    "openid-client": "^6.8.8",
    "re2js": "^2.9.0",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.5",
    "smtp-server": "^3.19.23",
    "turndown": "^7.2.4"
  }
}
