# Key used to encrypt Gotify tokens and SMTP credentials (AES-256-GCM).
# Generate with: openssl rand -hex 32
# If empty, a key is generated into /data/secret.key on first start (back it up!).
MAILBEACON_SECRET=

# Optional: seeds the global Gotify URL on first start (can be changed in the UI).
MAILBEACON_GOTIFY_URL=https://gotify.example.com

# Ports inside the container
MAILBEACON_SMTP_PORT=2525
MAILBEACON_WEB_PORT=8080

# Max accepted message size in KB (larger mail is rejected with 552)
MAILBEACON_MAX_SIZE_KB=1024

# Hostname announced in the SMTP greeting and used for the self-signed cert
MAILBEACON_SMTP_HOSTNAME=mailbeacon

# Public URL you open MailBeacon on; used for the OIDC redirect URI (<url>/api/oidc/callback)
MAILBEACON_PUBLIC_URL=

# Optional single sign-on (OpenID Connect). Values here override the Settings page.
# Authentik example issuer: https://auth.example.com/application/o/mailbeacon/
MAILBEACON_OIDC_ISSUER=
MAILBEACON_OIDC_CLIENT_ID=
MAILBEACON_OIDC_CLIENT_SECRET=
MAILBEACON_OIDC_SCOPES=openid profile email
# Comma-separated emails and/or group names allowed to log in (empty = anyone the provider authenticates)
MAILBEACON_OIDC_ALLOWED=

# Emergency switch: set to 1 to re-enable password login if SSO is broken
MAILBEACON_FORCE_LOCAL_LOGIN=
